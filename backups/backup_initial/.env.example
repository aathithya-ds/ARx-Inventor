# ARX INVENTOR - Environment Configuration Example
# Copy this file to .env and configure your API keys.

# 1. Google Gemini API (Used for Research Planning and Initial Scoping)
GEMINI_API_KEY=

# 2. OpenAI API (Used for Evidence Extraction, Analysis, and Synthesis)
OPENAI_API_KEY=

# 3. Anthropic Claude API (Used for Citation Review and Quality Assurance)
ANTHROPIC_API_KEY=

# Model Identifiers (Configurable)
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# System Settings
DEMO_MODE=false
DEFAULT_WORKSPACE_ID=default_user
DATABASE_PATH=data/arx_memory.db
CHROMA_PERSIST_DIR=data/chroma_db
UPLOADS_DIR=data/uploads
REPORTS_DIR=reports
